{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // ⚠️ `*.node.test.ts` is checked by tsconfig.node.json instead, where
  // `types: ["node"]` is in force. Exactly two tests legitimately need
  // `node:fs` — the purity scan (it reads every engine source file) and the
  // bulk-ingest run (it streams the real 86 MB card NDJSON). Adding "node" to
  // the types array HERE would put `process`, `Buffer` and `require` in scope
  // for every renderer file, which is the mistake those two tests exist to
  // prevent.
  "exclude": ["src/**/*.node.test.ts"]
}
